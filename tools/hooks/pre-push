#!/bin/sh
# pre-push gate: blocks pushes containing local-only test values.
# The forbidden patterns live in tools/local_only.txt, which is gitignored -
# so this script carries no knowledge of what it protects and is safe to
# commit. Activate it once per clone with:
#   git config core.hooksPath tools/hooks
# verify.sh stage 7 checks already-pushed refs; this hook stops the push
# itself, which is the moment a leak would actually happen.
ZERO=0000000000000000000000000000000000000000
PATFILE=tools/local_only.txt
if [ ! -f "$PATFILE" ]; then
  exit 0   # nothing declared - nothing to protect
fi
fail=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue          # deletion - nothing to scan
  for pat in $(grep -v '^#' "$PATFILE"); do
    if git grep -q "$pat" "$local_sha" -- 2>/dev/null; then
      echo "PRE-PUSH BLOCKED: '$pat' found in $local_ref ($local_sha)" >&2
      echo "  These are LOCAL-ONLY test values. Remove them or push an earlier commit." >&2
      fail=1
    fi
  done
done
exit $fail
